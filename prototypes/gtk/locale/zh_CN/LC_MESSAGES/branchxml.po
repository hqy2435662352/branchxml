#. Diagnostic messages from the Expat XML parser.
msgid "out of memory"
msgstr "内存不足"

msgid "syntax error"
msgstr "XML 语法错误"

msgid "no element found"
msgstr "未找到完整的 XML 元素"

msgid "not well-formed (invalid token)"
msgstr "XML 格式错误，含无效标记"

msgid "unclosed token"
msgstr "标记未闭合"

msgid "partial character"
msgstr "字符不完整"

msgid "mismatched tag"
msgstr "起始和结束标签不匹配"

msgid "duplicate attribute"
msgstr "属性名重复"

msgid "junk after document element"
msgstr "根元素之后有多余的内容"

msgid "illegal parameter entity reference"
msgstr "参数实体引用无效"

msgid "undefined entity"
msgstr "实体未定义"

msgid "recursive entity reference"
msgstr "实体引用存在循环"

msgid "asynchronous entity"
msgstr "实体的开始和结束不在同一解析上下文中"

msgid "reference to invalid character number"
msgstr "字符引用的编号无效"

msgid "reference to binary entity"
msgstr "引用了二进制实体"

msgid "reference to external entity in attribute"
msgstr "属性中引用了外部实体"

msgid "XML or text declaration not at start of entity"
msgstr "XML 声明或文本声明必须位于实体开头"

msgid "unknown encoding"
msgstr "未知的编码"

msgid "encoding specified in XML declaration is incorrect"
msgstr "XML 声明指定的编码不正确"

msgid "unclosed CDATA section"
msgstr "CDATA 段未闭合"

msgid "error in processing external entity reference"
msgstr "处理外部实体引用时出错"

msgid "document is not standalone"
msgstr "文档依赖外部声明"

msgid "unexpected parser state - please send a bug report"
msgstr "解析器状态异常，请报告此问题"

msgid "entity declared in parameter entity"
msgstr "实体在参数实体中声明"

msgid "requested feature requires XML_DTD support in Expat"
msgstr "此功能需要 Expat 的 XML_DTD 支持"

msgid "cannot change setting once parsing has begun"
msgstr "解析开始后无法更改此设置"

msgid "unbound prefix"
msgstr "命名空间前缀未声明"

msgid "must not undeclare prefix"
msgstr "不能撤销前缀声明"

msgid "incomplete markup in parameter entity"
msgstr "参数实体中的标记不完整"

msgid "XML declaration not well-formed"
msgstr "XML 声明格式错误"

msgid "text declaration not well-formed"
msgstr "文本声明格式错误"

msgid "illegal character(s) in public id"
msgstr "公共标识符包含无效字符"

msgid "parser suspended"
msgstr "解析器已暂停"

msgid "parser not suspended"
msgstr "解析器尚未暂停"

msgid "parsing aborted"
msgstr "解析已中止"

msgid "parsing finished"
msgstr "解析已完成"

msgid "cannot suspend in external parameter entity"
msgstr "无法在外部参数实体内暂停解析"

msgid "reserved prefix (xml) must not be undeclared or bound to another namespace name"
msgstr "不能撤销保留前缀 xml 的声明或将其绑定到其他命名空间"

msgid "reserved prefix (xmlns) must not be declared or undeclared"
msgstr "不能声明保留前缀 xmlns，也不能撤销其声明"

msgid "prefix must not be bound to one of the reserved namespace names"
msgstr "不能将前缀绑定到保留的命名空间"

msgid "invalid argument"
msgstr "参数无效"

msgid "a successful prior call to function XML_GetBuffer is required"
msgstr "必须先成功调用 XML_GetBuffer"

msgid "limit on input amplification factor (from DTD and entities) breached"
msgstr "DTD 和实体展开超过输入放大限制"

msgid "parser not started"
msgstr "解析器尚未启动"
